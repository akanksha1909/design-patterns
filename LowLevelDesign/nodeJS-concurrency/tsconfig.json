{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": false, // Explicitly turn off strict mode
    "noImplicitAny": false, // Allow variables to be implicitly typed as 'any'
    "noImplicitThis": false, // Allow 'this' to be implicitly 'any'
    "alwaysStrict": false, // Don't enforce 'use strict' in all files
    "skipLibCheck": true, // Skip type checking of declaration files (optional)
    "esModuleInterop": true, // Enable compatibility with ES modules (optional)
    "target": "ES6", // Set JavaScript target version (adjust as needed)
    "module": "commonjs" // Module system (adjust as needed)
  }
}
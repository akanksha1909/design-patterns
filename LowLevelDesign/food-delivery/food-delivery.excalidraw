    {
      "id": "SFxr4EJUHCadSvL0ONjQG",
      "type": "text",
      "x": 758.3988834248188,
      "y": 19077.997091141755,
      "width": 968,
      "height": 325,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 937486082,
      "version": 829,
      "versionNonce": 1228871938,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1757155723602,
      "link": null,
      "locked": false,
      "text": "Online Food Delivery\n\nRequirements\n- System can create restaurant and add menu.\n- System can add delivery partners.\n- User should be able to search for foods and restaurants (based on location)\n- User should be able to place an order (containing food items from a single restaurant)\n- User, Restaurant and Delivery Agent should be notified on order status updates\n- System should assign an order to nearby agent\n- Agent should be able to update their location\n- Agents should receive notification to pick an order and deliver\n- Restaurants should be notified when a new order is received.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Online Food Delivery\n\nRequirements\n- System can create restaurant and add menu.\n- System can add delivery partners.\n- User should be able to search for foods and restaurants (based on location)\n- User should be able to place an order (containing food items from a single restaurant)\n- User, Restaurant and Delivery Agent should be notified on order status updates\n- System should assign an order to nearby agent\n- Agent should be able to update their location\n- Agents should receive notification to pick an order and deliver\n- Restaurants should be notified when a new order is received.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ei0Tk65j2adk3aGpkg7nv",
      "type": "text",
      "x": 753.6770746887644,
      "y": 19406.556258342516,
      "width": 737,
      "height": 75,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3r",
      "roundness": null,
      "seed": 90913986,
      "version": 85,
      "versionNonce": 524834946,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1757155372409,
      "link": null,
      "locked": false,
      "text": "Bonus\n- User should be able to cancel the order only if status is PENDING\n- User should be able to track their order",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bonus\n- User should be able to cancel the order only if status is PENDING\n- User should be able to track their order",
      "autoResize": true,
      "lineHeight": 1.25
    },

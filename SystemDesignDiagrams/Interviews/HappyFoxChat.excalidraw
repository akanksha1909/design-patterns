      "link": null,
      "locked": false,
      "text": "Service register itself with Auth service\nGets the client Id and Access Key\nOn Making call to Ingestion Layer\nIt makes call to auth service to get the jwt tokens",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Service register itself with Auth service\nGets the client Id and Access Key\nOn Making call to Ingestion Layer\nIt makes call to auth service to get the jwt tokens",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "verticalAlign": "middle",
      "containerId": "bAO72lSZ8CvptNBFHAko9",
      "originalText": "Workers (Poll from the queue)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CINSxFpP1Yb92uDdhnnd0",
      "type": "text",
      "x": 3871.167365360582,
      "y": 15726.532829380973,
      "width": 374,
      "height": 225,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 636099217,
      "version": 225,
      "versionNonce": 1368228977,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774843193050,
      "link": null,
      "locked": false,
      "text": "Why SQS?\n\nSo that during peak times\nwhen we receive multiple files,\nqueue handles the bursty traffic\nand it will avoid overloading the\nserver.\nServer can consume at its own pace\nand process the file.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why SQS?\n\nSo that during peak times\nwhen we receive multiple files,\nqueue handles the bursty traffic\nand it will avoid overloading the\nserver.\nServer can consume at its own pace\nand process the file.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tY_TU1rxSk4MQBjQkYBLd",

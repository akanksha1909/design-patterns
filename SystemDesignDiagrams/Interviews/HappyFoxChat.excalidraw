    {
      "id": "MMY3gPkO-p6grk6Y1pVgT",
      "type": "text",
      "x": 2684.2152797326626,
      "y": 21779.631153608687,
      "width": 1232,
      "height": 125,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3T",
      "roundness": null,
      "seed": 1065968500,
      "version": 421,
      "versionNonce": 403897844,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775193115788,
      "link": null,
      "locked": false,
      "text": "1. If my service is down, and zoom tries to send events, and it will not be able to successfully send the events\n2. It will retry after sometime\n3. It stores the events in its queue and have exponential retries\n4. Incase my service is down for a long time, and zoom from its side also deleted the event.\n5. Here is where reconclialtion worker will come in the picture.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. If my service is down, and zoom tries to send events, and it will not be able to successfully send the events\n2. It will retry after sometime\n3. It stores the events in its queue and have exponential retries\n4. Incase my service is down for a long time, and zoom from its side also deleted the event.\n5. Here is where reconclialtion worker will come in the picture.",
      "autoResize": true,
      "lineHeight": 1.25
    },

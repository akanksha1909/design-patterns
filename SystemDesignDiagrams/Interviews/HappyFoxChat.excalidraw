      "versionNonce": 828939078,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775899301212,
      "link": null,
      "locked": false,
      "text": "1. Incoming requests are published to a topic keyed by agentId.\n2. The server that maintains the WebSocket connection for that agentId \nconsumes the message, as it is subscribed to that topic.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Incoming requests are published to a topic keyed by agentId.\n2. The server that maintains the WebSocket connection for that agentId \nconsumes the message, as it is subscribed to that topic.",
      "autoResize": true,
      "lineHeight": 1.25
    },

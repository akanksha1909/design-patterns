      "boundElements": [],
      "updated": 1774860375686,
      "link": null,
      "locked": false,
      "text": "Log Agents \nCollect data from log\nfiles\nAdd metadata like\nhost, region\nForward to Ingestion\nLayer\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "3Hwblo3NxrF7OnbeOtUBt",
      "originalText": "Log Agents \nCollect data from log files\nAdd metadata like host, region\nForward to Ingestion Layer\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iCj9OaHmA6WRtIrledfO9",
      "type": "text",
      "x": 2804.6279322059563,
      "y": 17913.80881030721,
      "width": 616,
      "height": 150,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 1122893435,
      "version": 213,
      "versionNonce": 1112683829,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774861937138,
      "link": null,
      "locked": false,
      "text": "Performs Authentication\nRate Limiting\nLoad Balancing\n\nIngestion layer fetches the private key from auth layer \nand validate the request",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Performs Authentication\nRate Limiting\nLoad Balancing\n\nIngestion layer fetches the private key from auth layer \nand validate the request",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DevkSiCPtr5FGogJTEZBx",
      "type": "text",
      "x": 3250.8231887356287,
      "y": 17648.576035595575,
      "width": 253,
      "height": 75,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1E",
      "roundness": null,
      "seed": 278190485,
      "version": 67,
      "versionNonce": 1740771413,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774860489513,
      "link": null,
      "locked": false,
      "text": "Smooth Spikes\nPrevent data loss\nEnable Async Processing",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Smooth Spikes\nPrevent data loss\nEnable Async Processing",

      "isDeleted": false,
      "boundElements": [],
      "updated": 1774860923114,
      "link": null,
      "locked": false,
      "text": "topic: logs\npartition: Either no key, making sure\nlogs go in either partition\n\nor trace_id, which makes sure all the logs\nof particular request will get process in order",

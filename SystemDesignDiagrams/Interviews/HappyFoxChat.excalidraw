    {
      "id": "sU_q_agWpe9FyeKsRE0vn",
      "type": "text",
      "x": 3897.9739627972363,
      "y": 16090.97950639411,
      "width": 385,
      "height": 100,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 288933425,
      "version": 109,
      "versionNonce": 1068898481,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774843297173,
      "link": null,
      "locked": false,
      "text": "Parse it\nIf parsing is failing consistently\nput the file from main queue to DLQ\nfor manual intervention",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parse it\nIf parsing is failing consistently\nput the file from main queue to DLQ\nfor manual intervention",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wj_wY-5nSqS33-u3gBVVF",
      "type": "text",
      "x": 3876.4836187481387,
      "y": 16218.790499949268,
      "width": 451,
      "height": 100,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 192780209,
      "version": 146,
      "versionNonce": 971351953,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774843643266,
      "link": null,
      "locked": false,
      "text": "At the end of processing, store in the DB\nthat whether the file is processed \nsuccessfully or not.\nThis will handle the idempotency.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At the end of processing, store in the DB\nthat whether the file is processed \nsuccessfully or not.\nThis will handle the idempotency.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lPokSkLmWoeBmvzrYCVqY",
      "type": "text",
      "x": 2352.083032614929,
      "y": 16360.739877536587,
      "width": 1133,
      "height": 425,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 1509407345,
      "version": 97,
      "versionNonce": 1517376543,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774844154520,
      "link": null,
      "locked": false,
      "text": "CREATE TABLE ingestion_files (\n  file_id           BIGSERIAL PRIMARY KEY,\n  bank_id           BIGINT NOT NULL,\n  file_name         TEXT NOT NULL,\n  file_path         TEXT NOT NULL,\n  checksum          TEXT NOT NULL,\n  received_at       TIMESTAMP NOT NULL DEFAULT NOW(),\n  status            TEXT NOT NULL,   -- received, validated, processing, processed, failed, quarantined\n  total_rows        INT DEFAULT 0,\n  success_rows      INT DEFAULT 0,\n  failed_rows       INT DEFAULT 0,\n  error_message     TEXT,\n\n  UNIQUE (bank_id, checksum)\n);\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE TABLE ingestion_files (\n  file_id           BIGSERIAL PRIMARY KEY,\n  bank_id           BIGINT NOT NULL,\n  file_name         TEXT NOT NULL,\n  file_path         TEXT NOT NULL,\n  checksum          TEXT NOT NULL,\n  received_at       TIMESTAMP NOT NULL DEFAULT NOW(),\n  status            TEXT NOT NULL,   -- received, validated, processing, processed, failed, quarantined\n  total_rows        INT DEFAULT 0,\n  success_rows      INT DEFAULT 0,\n  failed_rows       INT DEFAULT 0,\n  error_message     TEXT,\n\n  UNIQUE (bank_id, checksum)\n);\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Sa5C7CC4BnhdfBPg2u5uJ",
      "type": "text",
      "x": 3677.1323965632346,
      "y": 16415.031270416646,
      "width": 825,
      "height": 375,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1559325183,
      "version": 49,
      "versionNonce": 8666193,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774844006003,
      "link": null,
      "locked": false,
      "text": "CREATE TABLE raw_transaction_rows (\n  row_id            BIGSERIAL PRIMARY KEY,\n  file_id           BIGINT NOT NULL REFERENCES ingestion_files(file_id),\n  line_number       INT NOT NULL,\n  raw_payload       JSONB NOT NULL,\n  parse_status      TEXT NOT NULL,   -- parsed, failed_validation, rejected\n  error_reason      TEXT,\n  created_at        TIMESTAMP NOT NULL DEFAULT NOW(),\n\n  UNIQUE (file_id, line_number)\n);\n\n- Keeps the original data\n- helps debugging\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE TABLE raw_transaction_rows (\n  row_id            BIGSERIAL PRIMARY KEY,\n  file_id           BIGINT NOT NULL REFERENCES ingestion_files(file_id),\n  line_number       INT NOT NULL,\n  raw_payload       JSONB NOT NULL,\n  parse_status      TEXT NOT NULL,   -- parsed, failed_validation, rejected\n  error_reason      TEXT,\n  created_at        TIMESTAMP NOT NULL DEFAULT NOW(),\n\n  UNIQUE (file_id, line_number)\n);\n\n- Keeps the original data\n- helps debugging\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9G4UM6MXzLkQjbrIxKyZl",
      "type": "text",
      "x": 2328.047780013086,
      "y": 16765.380426244526,
      "width": 693,
      "height": 425,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 886075889,
      "version": 7,
      "versionNonce": 1633192241,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774844039320,
      "link": null,
      "locked": false,
      "text": "CREATE TABLE transactions (\n  transaction_pk    BIGSERIAL PRIMARY KEY,\n  bank_id           BIGINT NOT NULL,\n  account_id        BIGINT NOT NULL,\n  transaction_id    TEXT NOT NULL,\n  description       TEXT,\n  amount            NUMERIC(18,2) NOT NULL,\n  posted_date       DATE NOT NULL,\n  memo              TEXT,\n  source_file_id    BIGINT REFERENCES ingestion_files(file_id),\n  created_at        TIMESTAMP NOT NULL DEFAULT NOW(),\n  updated_at        TIMESTAMP NOT NULL DEFAULT NOW(),\n\n  UNIQUE (bank_id, transaction_id)\n);\n\n- ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE TABLE transactions (\n  transaction_pk    BIGSERIAL PRIMARY KEY,\n  bank_id           BIGINT NOT NULL,\n  account_id        BIGINT NOT NULL,\n  transaction_id    TEXT NOT NULL,\n  description       TEXT,\n  amount            NUMERIC(18,2) NOT NULL,\n  posted_date       DATE NOT NULL,\n  memo              TEXT,\n  source_file_id    BIGINT REFERENCES ingestion_files(file_id),\n  created_at        TIMESTAMP NOT NULL DEFAULT NOW(),\n  updated_at        TIMESTAMP NOT NULL DEFAULT NOW(),\n\n  UNIQUE (bank_id, transaction_id)\n);\n\n- ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SinVoy2IzapApQqeEMU7q",
      "type": "text",
      "x": 3249.870432645427,
      "y": 16850.210731701492,
      "width": 792,
      "height": 250,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

      "text": "Recordings\nProcessor",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "l__boCm-3QHd35z0GSqI-",
      "originalText": "Recordings Processor",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gUQk5q6IcmcoQuGP-u4ln",
      "type": "text",
      "x": 2614.8786656828743,
      "y": 18950.438437629844,
      "width": 957,
      "height": 75,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1X",
      "roundness": null,
      "seed": 1021793022,
      "version": 157,
      "versionNonce": 29092350,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775057353566,
      "link": null,
      "locked": false,
      "text": "1. We can store it in S3\n2. Incase recording processing fails, we dont endup pulling it again from these sources\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. We can store it in S3\n2. Incase recording processing fails, we dont endup pulling it again from these sources\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

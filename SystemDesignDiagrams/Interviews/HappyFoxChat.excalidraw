      "versionNonce": 1058324817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774844154520,
      "link": null,
      "locked": false,
      "text": "CREATE TABLE transaction_rejections (\n  rejection_id      BIGSERIAL PRIMARY KEY,\n  file_id           BIGINT NOT NULL REFERENCES ingestion_files(file_id),\n  line_number       INT NOT NULL,\n  raw_payload       JSONB NOT NULL,\n  rejection_reason  TEXT NOT NULL,\n  created_at        TIMESTAMP NOT NULL DEFAULT NOW()\n);\n\n- Store rows that couldn't be accepted",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE TABLE transaction_rejections (\n  rejection_id      BIGSERIAL PRIMARY KEY,\n  file_id           BIGINT NOT NULL REFERENCES ingestion_files(file_id),\n  line_number       INT NOT NULL,\n  raw_payload       JSONB NOT NULL,\n  rejection_reason  TEXT NOT NULL,\n  created_at        TIMESTAMP NOT NULL DEFAULT NOW()\n);\n\n- Store rows that couldn't be accepted",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uNGxcS5oQhXfS-sX92KM6",
      "type": "text",
      "x": 2418.0458436968456,
      "y": 17248.393498886922,
      "width": 550,
      "height": 375,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0v",

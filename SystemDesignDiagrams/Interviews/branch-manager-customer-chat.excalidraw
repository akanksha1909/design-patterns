      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Read the s3 url from DB\nDownload the file from S3\nValidate the file content\nProcess the file\nStore the parsed content into Database",

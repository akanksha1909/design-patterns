      "boundElements": [],
      "updated": 1767850462390,
      "link": null,
      "locked": false,
      "text": "FileMetaData\n- file_id\n- file_name\n- file_type\n- upload_id\n- file_size\n- status: UPLOADED | PROCESSING | COMPLETED | FAILED\n- s3_storage_path\n- created_at\n- updated_at\n\n\nProcessedFileData\n- record_id\n- file_id (FK)\n- data (JSONB data type) (Parsed file data)\n- created_at\n- updated_at",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FileMetaData\n- file_id\n- file_name\n- file_type\n- upload_id\n- file_size\n- status: UPLOADED | PROCESSING | COMPLETED | FAILED\n- s3_storage_path\n- created_at\n- updated_at\n\n\nProcessedFileData\n- record_id\n- file_id (FK)\n- data (JSONB data type) (Parsed file data)\n- created_at\n- updated_at",
      "autoResize": true,
      "lineHeight": 1.25
    },

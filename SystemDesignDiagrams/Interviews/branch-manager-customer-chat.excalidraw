      "updated": 1767851580651,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements\n- Chat should not be lost\n- Latency of replying to customer chat should be low\n- System should be able to handle the load of chat requests\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements\n- Chat should not be lost\n- Latency of replying to customer chat should be low\n- System should be able to handle the load of chat requests\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

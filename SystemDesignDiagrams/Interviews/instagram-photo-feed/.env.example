# PostgreSQL connection string for the persistent feed database
DATABASE_URL=postgresql://localhost:5432/instagram_feed

# Redis connection string for cache and feed index storage
REDIS_URL=redis://127.0.0.1:6379

# API server port
PORT=4000

# How long a cached feed should live in Redis
FEED_CACHE_TTL_SECONDS=300

# Maximum number of posts returned by default
FEED_LIMIT=50

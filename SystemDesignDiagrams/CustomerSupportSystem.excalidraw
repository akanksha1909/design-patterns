      "isDeleted": false,
      "boundElements": null,
      "updated": 1775230284437,
      "link": null,
      "locked": false,
      "text": "Client writes one messafe every 10 seconds\n\n- 20 messages to resolve one query\n\n- 1 message per customer (19 message from websocket)\n\n- \n\n\n- 100k customers in the queue at given point of timne\n- 10 machines to support\n- off peak hours (1k customers)\n\n\n- Auto Scaling (Sticky connection)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client writes one messafe every 10 seconds\n\n- 20 messages to resolve one query\n\n- 1 message per customer (19 message from websocket)\n\n- \n\n\n- 100k customers in the queue at given point of timne\n- 10 machines to support\n- off peak hours (1k customers)\n\n\n- Auto Scaling (Sticky connection)",
      "autoResize": true,
      "lineHeight": 1.25
    },
